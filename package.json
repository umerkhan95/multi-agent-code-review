{
  "name": "multi-agent-code-review",
  "version": "1.0.0",
  "description": "Multi-agent GitHub pull request reviewer built on the Claude Agent SDK, MCP and Zod",
  "type": "module",
  "main": "dist/main.js",
  "module": "dist/main.js",
  "exports": {
    ".": "./dist/main.js"
  },
  "author": "Umer Khan (built on the Udacity cd14715 starter)",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "claude",
    "agent-sdk",
    "code-review",
    "multi-agent",
    "ai"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.1.77",
    "@modelcontextprotocol/sdk": "1.32.1",
    "dotenv": "16.6.1",
    "winston": "3.18.3",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/node": "20.19.25",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "vitest": {
    "environment": "node",
    "globals": true
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/umerkhan95/multi-agent-code-review.git"
  }
}
