{
  "name": "multi-agent-code-review",
  "version": "1.0.0",
  "description": "Multi-agent GitHub pull request reviewer built on the Claude Agent SDK, MCP and Zod",
  "type": "module",
  "main": "dist/main.js",
  "module": "dist/main.js",
  "exports": {
    ".": "./dist/main.js"
  },
  "author": "Umer Khan (built on the Udacity cd14715 starter)",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --exclude tests/report-evals.test.ts",
    "eval": "vitest run tests/report-evals.test.ts",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "claude",
    "agent-sdk",
    "code-review",
    "multi-agent",
    "ai"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.77",
    "@modelcontextprotocol/sdk": "^1.23.0",
    "dotenv": "^16.0.0",
    "winston": "^3.11.0",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  },
  "vitest": {
    "environment": "node",
    "globals": true
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/umerkhan95/multi-agent-code-review.git"
  }
}
